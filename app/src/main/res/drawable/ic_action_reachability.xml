<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher-action icon for reachability: the home pulled down, a bar and a
     downward arrow. Built as the other action tiles are. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <background android:drawable="@color/launcherIconBackground" />
    <foreground>
        <aapt:attr name="android:drawable">
            <vector
                android:width="108dp"
                android:height="108dp"
                android:viewportWidth="108"
                android:viewportHeight="108">
                <group
                    android:scaleX="2.25"
                    android:scaleY="2.25"
                    android:translateX="27"
                    android:translateY="27">
                    <path
                        android:fillColor="#3F72AF"
                        android:pathData="M16,13h-3V3h-2v10H8l4,4 4,-4zM4,19v2h16v-2H4z" />
                </group>
            </vector>
        </aapt:attr>
    </foreground>
</adaptive-icon>
