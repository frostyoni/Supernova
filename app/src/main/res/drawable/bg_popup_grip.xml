<?xml version="1.0" encoding="utf-8"?>
<!-- The resize grip on a pop-up widget: a dark disc with a light rim, so it
     reads over widgets of either colour. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#99000000" />
    <stroke
        android:width="1dp"
        android:color="#66FFFFFF" />
</shape>
