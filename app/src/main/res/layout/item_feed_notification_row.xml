<?xml version="1.0" encoding="utf-8"?>
<!-- One notification under the glance card: the app's icon, its title and one
     line of text. Tapping sends the notification's own content intent. Rows
     are added programmatically (<= 6). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/space_xs">

    <ImageView
        android:id="@+id/notificationIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_ms"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.supernova.launcher.ui.FadingTextView
            android:id="@+id/notificationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="@dimen/text_secondary" />

        <com.supernova.launcher.ui.FadingTextView
            android:id="@+id/notificationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>
</LinearLayout>
